# Runtime
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
CORS_ORIGINS=http://localhost:3000

# PostgreSQL (local Docker defaults).
# Production DATABASE_URL points to Supabase PostgreSQL and is consumed server-side by NestJS/Prisma only.
DATABASE_URL=postgresql://nasq:nasq_dev_password@localhost:5432/nasq?schema=public
POSTGRES_DB=nasq
POSTGRES_USER=nasq
POSTGRES_PASSWORD=nasq_dev_password

# Authentication - replace in every non-local environment.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
AUTH_COOKIE_SECURE=false

# Web -> Backend API only. Never expose DATABASE_URL, Supabase service-role/secret keys,
# or privileged database credentials through NEXT_PUBLIC_* or client bundles.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
